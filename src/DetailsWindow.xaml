<Window x:Class="MayaXBattery.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAMZU · Battery"
        Icon="/Assets/MayaX-Battery.ico"
        Width="400" Height="566"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#171D21" Foreground="#ECF2F1"
        FontFamily="Segoe UI" SnapsToDevicePixels="True"
        UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#ECF2F1"/>
        <SolidColorBrush x:Key="Muted" Color="#A4B3B6"/>
        <SolidColorBrush x:Key="Accent" Color="#8FE2C9"/>
        <SolidColorBrush x:Key="Panel" Color="#20292C"/>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8FE2C9"/>
            <Setter Property="Foreground" Value="#10241F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B2F2DE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#6EC6AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#405853"/>
                                <Setter Property="Foreground" Value="#B0C3BD"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LanguageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20292C"/>
            <Setter Property="Foreground" Value="#ECF2F1"/>
            <Setter Property="BorderBrush" Value="#344B48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2D4B48"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#ECF2F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" PanningMode="VerticalOnly">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BatteryHeading" Text="BATTERY LEVEL" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="EnglishButton" Width="53" Height="27" Margin="0,0,5,0" ToolTip="English"
                        Style="{StaticResource LanguageButtonStyle}" Click="OnEnglishClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="12" ClipToBounds="True" Background="#173A75" Margin="0,0,5,0">
                            <Canvas Width="20" Height="12">
                                <Path Fill="White" Data="M0,0 L3,0 20,10 20,12 17,12 0,2 Z M20,0 L17,0 0,10 0,12 3,12 20,2 Z"/>
                                <Path Fill="#D8424A" Data="M0,0 L1.4,0 20,11 20,12 18.6,12 0,1 Z M20,0 L18.6,0 0,11 0,12 1.4,12 20,1 Z"/>
                                <Rectangle Width="20" Height="4" Canvas.Top="4" Fill="White"/>
                                <Rectangle Width="6" Height="12" Canvas.Left="7" Fill="White"/>
                                <Rectangle Width="20" Height="2" Canvas.Top="5" Fill="#D8424A"/>
                                <Rectangle Width="3" Height="12" Canvas.Left="8.5" Fill="#D8424A"/>
                            </Canvas>
                        </Border>
                        <TextBlock Text="EN" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RussianButton" Width="53" Height="27" ToolTip="Русский"
                        Style="{StaticResource LanguageButtonStyle}" Click="OnRussianClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="12" ClipToBounds="True" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/><RowDefinition Height="4"/><RowDefinition Height="4"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Fill="White"/>
                                <Rectangle Grid.Row="1" Fill="#3156A0"/>
                                <Rectangle Grid.Row="2" Fill="#D83C48"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="RU" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PercentText" Grid.Column="0" Text="?" FontSize="70"
                       FontWeight="Bold" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" AutomationProperties.Name="Battery level"/>
            <Viewbox x:Name="MouseIconView" Grid.Column="1" Width="38" Height="64" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     AutomationProperties.Name="Mouse icon">
                <Canvas Width="100" Height="170">
                    <Path Data="M 50,3 C 17,3 1,28 1,55 L 1,117 C 1,148 19,167 50,167 C 81,167 99,148 99,117 L 99,55 C 99,28 83,3 50,3 Z"
                          Fill="#223533" Stroke="#8FE2C9" StrokeThickness="3.2"
                          StrokeLineJoin="Round"/>
                    <Rectangle Canvas.Left="47" Canvas.Top="37" Width="6" Height="20"
                               RadiusX="3" RadiusY="3" Fill="#8FE2C9"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,1,0,0">
            <TextBlock x:Name="StateText" Text="Waiting for data" FontSize="13"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Grid Height="5" Margin="0,17,0,0" Background="#334146" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChargeColumn" Width="0*"/>
                    <ColumnDefinition x:Name="RemainderColumn" Width="100*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ChargeFill" Grid.Column="0" Background="{StaticResource Accent}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="RateHeading" Text="Drain rate" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="RateText" Text="···" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="RemainingHeading" Text="Remaining" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="HoursText" Text="···" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="NoteText" Grid.Row="4" Margin="0,15,0,8"
                   Text="An estimate will appear after the battery level changes."
                   FontSize="12" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <Grid Grid.Row="6" Margin="0,9,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#344044"/>
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdatedText" Text="The first check has not finished"
                           Foreground="{StaticResource Muted}" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh"
                        Style="{StaticResource RefreshButtonStyle}" Height="36"
                        AutomationProperties.Name="Refresh mouse battery level" Click="OnRefreshClick"/>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button x:Name="DiagnosticsButton" Content="Export diagnostics…" Height="34"
                        Style="{StaticResource LanguageButtonStyle}"
                        AutomationProperties.AutomationId="ExportDiagnostics"
                        Click="OnDiagnosticsClick"/>
                <TextBlock x:Name="DiagnosticsNote" Margin="0,7,0,0" FontSize="10"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Local ZIP report. Nothing is uploaded."/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
